# Copy to .env.prod and fill in real values — every one of these is
# required (docker-compose.prod.yml refuses to start without it, deliberately
# unlike the dev-friendly defaults in docker-compose.yml/.env.example).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod build
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#   docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm backend alembic upgrade head
#
# Login is entirely local now (this app's own `users` table — see
# app/services/local_auth.py). No account exists until you create one:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm backend python -m scripts.create_user <username> <password>
# Deliberately not scripts/seed.py — that one also inserts example imx.*
# referential data meant only for local dev/CI.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=trait_ai

# A real random secret — e.g. `openssl rand -hex 32` — never the
# back/app/core/config.py dev default.
JWT_SECRET=

# Host port nginx (the frontend) listens on.
HTTP_PORT=8080

# --- Real OCR/extraction (optional — see app/services/vlm_extraction.py) --
# Leave OCR_PROVIDER unset/"stub" until the OCR vendor/data-residency
# decision is made (see BACKLOG.md) — a production deploy shouldn't
# silently start sending scans anywhere just because it went live.
OCR_PROVIDER=stub
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
