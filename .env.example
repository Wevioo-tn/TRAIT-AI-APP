# Copy to .env and adjust for your machine. Every value already has a safe
# default in docker-compose.yml / app/core/config.py, so .env is optional
# for local development — it exists for the values you'll actually want to
# override (ports already in use, non-default credentials, etc).

POSTGRES_USER=trait
POSTGRES_PASSWORD=trait
POSTGRES_DB=trait_ai
POSTGRES_PORT=5432

BACKEND_PORT=8000
# Also used to build the backend's CORS_ALLOWED_ORIGINS in docker-compose.yml
# — change this and the backend still knows to accept the frontend's
# requests, no separate setting to keep in sync.
FRONTEND_PORT=5173

# --- Real OCR/extraction (Sprint 8, app/services/vlm_extraction.py) -------
# "stub": no real image reading (the default — safe until you opt in).
# "azure_openai": Azure OpenAI's vision-capable chat model — the only real
# provider. Which one to pick is a data-residency/compliance decision, not
# a technical one — see BACKLOG.md.
OCR_PROVIDER=stub

# Required only when OCR_PROVIDER=azure_openai.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
